table constructor_performance
	lineageTag: 557b17cf-bffa-4965-be07-e8bdaa28c77b

	measure 'Leading Constructor' =
			
			
			VAR TopConstructor =
			    TOPN(
			        1,
			        constructor_performance,
			        constructor_performance[total_points],
			        DESC
			    )
			
			RETURN
			    MAXX(
			        TopConstructor,
			        constructor_performance[name]
			    )
		lineageTag: 73692210-a284-4040-b488-08753ec73a26

	measure 'Leading Constructor Points' =
			
			
			MAXX(
			    TOPN(
			        1,
			        constructor_performance,
			        constructor_performance[total_points],
			        DESC
			    ),
			    constructor_performance[total_points]
			)
		formatString: 0
		lineageTag: ca8b13ba-c671-4016-b6d0-6186bd47edbf

		annotation PBI_FormatHint = {"isDecimal":true}

