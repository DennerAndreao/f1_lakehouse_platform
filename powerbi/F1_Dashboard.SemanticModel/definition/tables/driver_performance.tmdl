table driver_performance
	lineageTag: c18c25ab-8ba6-444c-b4ab-17472007fde1

	measure 'Championship Leader' =
			
			
			VAR TopDriver =
			    TOPN(
			        1,
			        driver_performance,
			        driver_performance[total_points],
			        DESC
			    )
			
			RETURN
			    MAXX(
			        TopDriver,
			        driver_performance[family_name]
			    )
		lineageTag: 2a8956cc-41bd-4424-afc8-a9f2d3974ef3

	measure 'Leader Points' =
			
			
			MAXX(
			    TOPN(
			        1,
			        driver_performance,
			        driver_performance[total_points],
			        DESC
			    ),
			    driver_performance[total_points]
			)
		formatString: 0
		lineageTag: 6ef39a7f-f7e3-426a-bcac-fb69595c5427

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Total Drivers' =
			
			
			DISTINCTCOUNT(
			    driver_performance[driver_id]
			)
		formatString: 0
		lineageTag: a2f670a9-14fd-4265-b584-7b6f6c0af444

